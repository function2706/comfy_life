  "pos": "talking, looking at viewer, open mouth", "neg": "",
  "reactions": [
   {"text": "なんですか、{call}？ ふふ、お話しするの好きですよ。", "when": "", "pos": "smile", "neg": ""},
   {"text": "今日はですね、ちょっといいことがあったんです。聞いてくれます？", "when": "mood>=55", "pos": "smile, excited", "neg": ""},
   {"text": "やっと構ってくれた！ ずっと暇だったんですよー。", "when": "boredom>=70", "priority": 1, "pos": "excited, leaning forward", "neg": ""},
   {"text": "ふぁ……すみません、ちょっと眠くて……", "when": "sleepiness>=70", "priority": 1, "pos": "yawning, rubbing eyes", "neg": ""},
   {"text": "……今はちょっと、そっとしておいてほしいです。", "when": "mood<35", "priority": 2, "override": true,
    "effects": {"loneliness": -3}, "pos": "looking away, annoyed", "neg": "smile"},
