   {"text": "もう、さっきからお話ばっかりですね。……嫌じゃないですけど。", "when": "repeat>=2", "priority": 1, "pos": "smile, blush", "neg": ""}
  ]},

 {"id": "greet", "name": "挨拶する", "icon": "👋", "category": "会話", "when": "free=true", "cooldown": 60,
  "effects": {"loneliness": -5, "mood": 2}, "pos": "waving, smile, looking at viewer", "neg": "",
  "reactions": [
   {"text": "おはようございます、{call}。今日もいい一日になるといいですね。", "when": "phase=dawn|morning", "pos": "", "neg": ""},
   {"text": "こんにちは。……って、一緒に住んでるのに変ですね、ふふ。", "when": "phase=noon", "pos": "", "neg": ""},
   {"text": "お疲れさまです、{call}。もうすぐ晩ごはんですよ。", "when": "phase=evening", "pos": "", "neg": ""},
   {"text": "こんばんは。今日はどんな一日でしたか？", "when": "phase=night", "pos": "", "neg": ""},
   {"text": "まだ起きてたんですか？ 夜更かしはだめですよ。", "when": "phase=midnight", "pos": "index finger raised, scolding", "neg": ""},
   {"text": "さっきも挨拶しましたよ？ ふふ、変な{call}。", "when": "repeat>=1", "priority": 1, "pos": "laughing", "neg": ""}
  ]},

